# ========== 应用 ==========
APP_NAME=Enterprise RAG
APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs
# 允许跨域的前端地址，逗号分隔；留空表示不启用 CORS
CORS_ALLOW_ORIGINS=

# 鉴权模式：dev（本地占位身份，禁止生产）/ oidc（企业 SSO，OIDC + JWT）/ ldap（预留未实现）
AUTH_MODE=dev
DEV_TENANT_ID=default
DEV_USER_ID=dev-user
# AUTH_MODE=oidc 时必填前三项；claim 名按 IdP 实际下发字段调整
# OIDC_KB_CLAIM 支持 list 或逗号分隔字符串，IdP 不下发该 claim 表示不限制知识库范围
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_KB_CLAIM=allowed_kb_ids
# 用户组 claim：映射到文档级 ACL 的 allowed_groups；Keycloak 默认下发 groups（list）
OIDC_GROUP_CLAIM=groups
# fail-closed：IdP 未下发 groups claim 时默认按"无授权组"处理（只能看公开文档）
# 仅历史兼容场景才显式设为 true（缺少 groups = 不限权）
OIDC_ALLOW_MISSING_GROUPS=false

# AUTH_MODE=ldap 时必填前两项：HTTP Basic 凭证 → 服务账号搜用户 → 用户 rebind 验密码
LDAP_SERVER_URL=
LDAP_USER_SEARCH_BASE=
# 服务账号 bind（留空则匿名）；用于搜索用户与用户组
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# 用户搜索过滤器，{username} 为占位符；组过滤器占位符 {user_dn} / {username}
LDAP_USER_SEARCH_FILTER=(uid={username})
# 组搜索 base 留空时回落 LDAP_USER_SEARCH_BASE
LDAP_GROUP_SEARCH_BASE=
LDAP_GROUP_SEARCH_FILTER=(member={user_dn})
LDAP_GROUP_NAME_ATTRIBUTE=cn
# 组 → 知识库映射（JSON 对象），如 {"finance":["kb-1"],"hr":["kb-2"]}；留空表示不限制
LDAP_GROUP_KB_MAP=
LDAP_TIMEOUT_S=10

# ========== 数据存储 ==========
# 默认 PostgreSQL；已有 MySQL 时改成 mysql+asyncmy://user:pass@host:3306/rag
DATABASE_URL=postgresql+asyncpg://rag:rag@127.0.0.1:5432/rag
REDIS_URL=redis://127.0.0.1:6379/0
# 测试专用：true 时 Celery 任务同步执行，无需 worker；生产必须为 false
CELERY_EAGER=false
# 检索热点缓存 TTL（秒）：复用 REDIS_URL，只缓存召回 chunks 不缓存答案；
# 入库 / 删除文档会自动按知识库失效；<=0 表示禁用缓存
RETRIEVAL_CACHE_TTL_S=300

MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default

ES_URL=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=

# 原始文件对象存储（MinIO / S3 兼容）
# 本地 docker-compose.dev.yml 用 SeaweedFS 的 S3 网关 8333 端口；生产接 MinIO 时改为 9000
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-raw
S3_REGION=us-east-1
S3_USE_SSL=false

# ========== 知识库配置 ==========
KB_CONFIG_DIR=./configs/kbs
DEFAULT_TENANT_ID=default
# 知识库写操作（POST/PUT/DELETE /kbs）的管理员组；留空表示任何未受限用户都可管理。
# 受限用户（IdP 下发 allowed_kb_ids）始终没有管理权限
KB_ADMIN_GROUP=

# ========== Embedding ==========
# remote 优先，不可用时按 MODEL_DEVICE_PREFERENCE 降级到本地 GPU/CPU
EMBEDDING_BACKEND=remote
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=http://127.0.0.1:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_S=30
EMBEDDING_BATCH_SIZE=32

# ========== Reranker ==========
# none：关闭精排，直接用 RRF 融合排序（本地开发默认）；
# remote：启用远程精排服务（如硅基流动 / Jina），需填写 RERANK_API_BASE 与 RERANK_API_KEY，
#         模型名按服务商文档调整（如 BAAI/bge-reranker-v2-m3），服务不可用时自动回退 RRF 排序；
# local：本地 sentence-transformers 精排（需安装 local-models 可选依赖）
RERANK_BACKEND=none
RERANK_MODEL=BAAI/bce-reranker-base-zh
RERANK_API_BASE=http://127.0.0.1:8081/v1
RERANK_API_KEY=
RERANK_TIMEOUT_S=30
# 精排批大小：同 batch 内按文本长度排序，减少 padding 浪费
RERANK_BATCH_SIZE=16
# 送精排的候选上限：控制单次 Cross-Encoder 推理量，避免长尾查询拖垮 P99
RERANK_MAX_CANDIDATES=50
# 按需精排：简单问题且向量首名相似度 >= 该值时跳过精排（0=始终精排）
RERANK_SKIP_CONFIDENCE=0

# ========== 缓存 / 上下文压缩 ==========
# Query Embedding 缓存：同一问题 TTL 内复用向量，避免重复调用模型；<=0 禁用
QUERY_EMBEDDING_CACHE_TTL_S=3600
QUERY_EMBEDDING_CACHE_MAX_ENTRIES=2048
# 抽取式上下文压缩：只保留相关句，但强制保留条件/否定/时间/数值/权限等约束
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_MAX_SENTENCES=8
CONTEXT_COMPRESSION_MIN_CHARS=200

# ========== LLM ==========
# remote：OpenAI 兼容接口；ollama：本地 Ollama
LLM_BACKEND=remote
LLM_MODEL=qwen2.5-72b-instruct
LLM_API_BASE=http://127.0.0.1:8082/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_S=120

# 模型后端优先级：remote -> cuda -> cpu
MODEL_DEVICE_PREFERENCE=remote,cuda,cpu

# ========== 检索 / 切块默认值（KB YAML 可覆盖） ==========
CHUNK_SIZE=512
CHUNK_OVERLAP=60
RETRIEVE_TOP_K=20
RERANK_TOP_N=6
RRF_K=60
